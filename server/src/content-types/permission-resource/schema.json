{
  "kind": "collectionType",
  "collectionName": "permission_resources",
  "info": {
    "singularName": "permission-resource",
    "pluralName": "permission-resources",
    "displayName": "Permission Route Resource"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "key": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "label": {
      "type": "string",
      "required": true
    },
    "resourceType": {
      "type": "enumeration",
      "enum": ["standard", "extended", "alias"],
      "default": "standard",
      "required": true
    },
    "pathPattern": {
      "type": "string",
      "required": true
    },
    "method": {
      "type": "enumeration",
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"],
      "required": true
    },
    "contentTypeUid": {
      "type": "string"
    },
    "controllerAction": {
      "type": "string"
    },
    "aliasPath": {
      "type": "string"
    },
    "effect": {
      "type": "enumeration",
      "enum": ["allow", "deny"],
      "default": "allow",
      "required": true
    },
    "conditions": {
      "type": "json",
      "default": []
    },
    "requestRules": {
      "type": "json",
      "default": {}
    },
    "responseRules": {
      "type": "json",
      "default": {}
    },
    "isPublic": {
      "type": "boolean",
      "default": false
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
}
