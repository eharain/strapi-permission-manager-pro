{
  "kind": "collectionType",
  "collectionName": "permission_resources",
  "info": {
    "singularName": "permission-resource",
    "pluralName": "permission-resources",
    "displayName": "Permission Resource"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "key": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "uid": {
      "type": "string",
      "required": true
    },
    "methods": {
      "type": "json",
      "default": ["get", "post", "put", "delete"]
    },
    "fieldScope": {
      "type": "enumeration",
      "enum": ["all", "selected"],
      "default": "all",
      "required": true
    },
    "fields": {
      "type": "json",
      "default": []
    },
    "domain": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::permission-manager-pro.permission-domain"
    },
    "parentResource": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::permission-manager-pro.permission-resource"
    }
  }
}