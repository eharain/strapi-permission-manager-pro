{
  "kind": "collectionType",
  "collectionName": "permission_domains",
  "info": {
    "singularName": "permission-domain",
    "pluralName": "permission-domains",
    "displayName": "Permission App Domain"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "key": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "strapiRoleType": {
      "type": "string",
      "required": true,
      "default": "authenticated"
    },
    "matchMode": {
      "type": "enumeration",
      "enum": ["header", "query", "both"],
      "default": "header",
      "required": true
    },
    "matchKey": {
      "type": "string",
      "required": true,
      "default": "x-rutba-app"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
}
