{
  "kind": "collectionType",
  "collectionName": "permission_roles",
  "info": {
    "singularName": "permission-role",
    "pluralName": "permission-roles",
    "displayName": "Permission Role"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "key": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "level": {
      "type": "enumeration",
      "enum": [
        "staff",
        "manager",
        "admin",
        "super-admin"
      ],
      "required": true
    },
    "domain": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::permission-manager-pro.permission-domain"
    },
    "users": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "permission_roles"
    }
  }
}